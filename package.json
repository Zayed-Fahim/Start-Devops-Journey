{
  "name": "start-devops-journey",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm --dir backend lint && pnpm --dir frontend lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yaml,yml}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "backend/**/*.js": [
      "prettier --write",
      "pnpm --dir backend exec eslint --fix"
    ],
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "pnpm --dir frontend exec eslint --fix"
    ],
    "**/*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
