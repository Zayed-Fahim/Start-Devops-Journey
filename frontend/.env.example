# =============================================================================
# frontend/.env.local  —  LAYER 2: container runtime environment
# =============================================================================
# Copy to `.env.local`:  cp frontend/.env.example frontend/.env.local
# =============================================================================

NODE_ENV=development
PORT=3000

# --- The two-URL problem (fully wired up in Phase 4) -------------------------
# The frontend calls the backend from TWO different places, and they do not
# share a DNS namespace:
#
#   Server Components / Route Handlers  ->  run INSIDE the frontend container
#                                           -> can resolve `backend` via Docker DNS
#
#   Client Components ("use client")    ->  run in the USER'S BROWSER
#                                           -> has never heard of `backend`
#
# One variable cannot serve both. Using `http://backend:3001` in the browser
# gives you `ERR_NAME_NOT_RESOLVED`; using `http://localhost:3001` on the
# server gives you `ECONNREFUSED`, because inside the container localhost is
# the frontend itself.
INTERNAL_API_URL=http://backend:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# NEXT_PUBLIC_ is not a naming style — it is a Next.js contract. Any variable
# with that prefix is INLINED INTO THE JAVASCRIPT BUNDLE at build time and
# shipped to every visitor. Never put a secret behind that prefix.
