# =============================================================================
# ROOT .env  —  LAYER 1: Docker Compose interpolation
# =============================================================================
# Copy this file to `.env` and adjust:  cp .env.example .env
#
# WHAT THIS FILE IS
# -----------------
# The Docker CLI reads THIS file (the root `.env`) before it parses
# docker-compose.yaml, and uses it to substitute every `${VARIABLE}` in that
# file. This happens on your HOST machine, at parse time.
#
# WHAT THIS FILE IS *NOT*
# -----------------------
# These variables are NOT automatically visible inside the containers. A
# container only sees what you hand it via `environment:` or `env_file:`.
# That is Layer 2 — see backend/.env.example and frontend/.env.example.
#
# Confusing the two layers is the single most common Compose mistake:
# "I set it in .env, why is process.env.FOO undefined?"  Because .env
# configures the *compose file*, not the *container*.
# =============================================================================


# --- Build-time --------------------------------------------------------------
# Pinned, not `latest`. A floating base image means your build succeeds today
# and fails next Tuesday for reasons that have nothing to do with your commit.
NODE_VERSION=22-alpine

# Which Dockerfile each service builds from. Swapping dev -> prod here is how
# you test the production image locally without editing docker-compose.yaml.
BACKEND_DOCKERFILE=Dockerfile.dev
FRONTEND_DOCKERFILE=Dockerfile.dev


# --- Runtime env files (Layer 2 pointers) ------------------------------------
# Paths are relative to docker-compose.yaml. These files must EXIST or
# `docker compose config` fails outright — Compose will not invent them.
BACKEND_ENV_FILE=./backend/.env.dev
FRONTEND_ENV_FILE=./frontend/.env.local


# --- Host port mappings ------------------------------------------------------
# Left side of `"3001:3001"` = your laptop. Right side = inside the container.
# Change these if something else on your machine already owns the port.
BACKEND_PORT=3001
FRONTEND_PORT=3000


# --- MongoDB (replaced by PostgreSQL in Phase 2) -----------------------------
MONGO_DB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme_locally

# --- mongo-express (replaced by Adminer in Phase 2) --------------------------
MONGO_EXPRESS_PORT=8081
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=changeme_locally


# =============================================================================
# PRODUCTION NOTE
# =============================================================================
# In production none of these secrets live in a file on disk next to the code.
# They come from a secret manager (AWS Secrets Manager, Vault, SOPS) or Docker
# secrets, are generated rather than typed, and are rotated. A plaintext .env
# is a *local development* convenience — worth staying conscious of the
# difference so the habit doesn't follow you to a real server.
# =============================================================================
