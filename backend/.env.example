# =============================================================================
# backend/.env.dev  —  LAYER 2: container runtime environment
# =============================================================================
# Copy to `.env.dev`:  cp backend/.env.example backend/.env.dev
#
# Compose loads this file into the backend container via `env_file:`, so every
# variable here lands in `process.env` inside the running Node process.
#
# NAMING: these keys must match EXACTLY what the code reads. The previous
# version of this file used MONGODB_* while src/connect.js read MONGO_DB_* —
# so every value came back `undefined` and the connection string silently
# became "mongodb://undefined:undefined@undefined:undefined". The app didn't
# crash, it just never connected. Env var typos fail quietly; that is what
# makes them expensive.
# =============================================================================

NODE_ENV=development

# The server reads this. Do not hardcode a port in server.js — the container
# and the host must agree, and that agreement lives in configuration.
PORT=3001

# --- MongoDB connection (replaced by DATABASE_URL in Phase 2) ----------------
# HOST is the Compose *service name*, not localhost. Inside this container,
# `localhost` is the backend itself — there is no database listening there.
# Docker's embedded DNS resolves `mongodb` to the database container's IP.
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=changeme_locally
MONGO_DB_HOST=mongodb
MONGO_DB_PORT=27017
MONGO_DB_NAME=devops_journey
