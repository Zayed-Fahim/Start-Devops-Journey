# =============================================================================
# backend/.env.dev  —  LAYER 2: container runtime environment
# =============================================================================
# Copy to `.env.dev`:  cp backend/.env.example backend/.env.dev
#
# Compose loads this file into the backend container via `env_file:`, so every
# variable here lands in `process.env` inside the running Node process.
#
# NAMING: these keys must match EXACTLY what the code reads. An earlier version
# of this file declared MONGODB_* while src/connect.js read MONGO_DB_*, so the
# connection string silently became
# "mongodb://undefined:undefined@undefined:undefined". Nothing threw; it just
# never connected. Env var typos fail quietly, which is what makes them
# expensive.
# =============================================================================

NODE_ENV=development

# The server reads this. Do not hardcode a port in server.js — the container
# and the host must agree, and that agreement belongs in configuration.
PORT=3001

# --- PostgreSQL --------------------------------------------------------------
# The host is `postgres`: the Compose SERVICE NAME, resolved by Docker's
# embedded DNS on app-network. NOT localhost — inside the backend container
# localhost is the backend itself, and nothing is listening on :5432 there.
#
# The port is 5432, the port INSIDE the container. POSTGRES_PORT in the root
# .env is the HOST-side mapping and is irrelevant here: container-to-container
# traffic never touches the host's published ports.
#
# Credentials must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the
# root .env — two files, one truth, kept in sync by hand. (Production solves
# this properly with a secret manager injecting both from one source.)
DATABASE_URL=postgresql://devops:changeme_locally@postgres:5432/devops_journey?schema=public

# --- CORS --------------------------------------------------------------------
# The browser origin allowed to call this API. This is the address the USER's
# browser uses (http://localhost:3000), not the Docker-internal one — CORS is
# enforced by the browser, and the browser has never heard of `frontend`.
CORS_ORIGIN=http://localhost:3000
