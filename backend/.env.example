NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://postgres.emfijblsybyxlfhzbrzf:<your-supabase-db-password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.emfijblsybyxlfhzbrzf:<your-supabase-db-password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# node-postgres pool size for the driver adapter (Prisma 7 owns the connection
# through pg now, so this replaces the old connection_limit URL parameter).
DB_POOL_MAX=10

JWT_ACCESS_SECRET=<run: openssl rand -base64 48>
JWT_REFRESH_SECRET=<run: openssl rand -base64 48>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Created on boot if the email is not already taken; skipped when it is.
# Also the account that `pnpm run db:reset` and `db:clear --users` refuse to delete.
# Leave both blank to turn the bootstrap off.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_ROLE=ADMIN
