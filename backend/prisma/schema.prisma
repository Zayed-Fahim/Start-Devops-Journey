generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AuditCategory {
  CREATE
  UPDATE
  DELETE
  SECURITY
}

enum TimeFormat {
  H12
  H24
}

enum DocumentKind {
  DOCS
  SUPPORT
}

enum SupportStatus {
  OPEN
  CLOSED
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(120)
  email    String @unique @db.VarChar(255)
  password String

  status Status @default(ACTIVE)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  country    String?    @db.VarChar(2)
  timezone   String?    @db.VarChar(64)
  timeFormat TimeFormat @default(H24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId  String?     @db.Uuid
  roleRef AccessRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  teamMemberships  TeamMember[]
  ledTeams         Team[]           @relation("TeamLead")
  notifications    Notification[]
  supportRequests  SupportRequest[] @relation("SupportRequester")
  resolvedRequests SupportRequest[] @relation("SupportResolver")
  editedDocuments  Document[]       @relation("DocumentEditor")

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Team {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(64)
  description String? @db.VarChar(255)

  leadUserId String? @db.Uuid
  lead       User?   @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]

  @@index([leadUserId])
  @@map("teams")
}

model TeamMember {
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(64)
  label       String  @db.VarChar(120)
  description String? @db.VarChar(255)
  group       String  @db.VarChar(32)
  sortOrder   Int     @default(0)

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model AccessRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(64)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  actorLabel String        @db.VarChar(160)
  action     String        @db.VarChar(64)
  category   AuditCategory
  summary    String        @db.VarChar(500)

  targetType  String? @db.VarChar(32)
  targetId    String? @db.VarChar(64)
  targetLabel String? @db.VarChar(255)

  ip        String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  familyId  String @db.Uuid

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userAgent String? @db.VarChar(255)
  ip        String? @db.VarChar(64)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String        @db.VarChar(160)
  body     String?       @db.VarChar(500)
  href     String?       @db.VarChar(255)
  category AuditCategory @default(UPDATE)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Document {
  id   String       @id @default(uuid()) @db.Uuid
  kind DocumentKind
  slug String       @db.VarChar(64)

  title String @db.VarChar(160)
  body  String

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("DocumentEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, slug])
  @@index([kind])
  @@map("documents")
}

model SupportRequest {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("SupportRequester", fields: [userId], references: [id], onDelete: Cascade)

  subject String        @db.VarChar(160)
  body    String        @db.VarChar(2000)
  status  SupportStatus @default(OPEN)

  resolvedById String?   @db.Uuid
  resolvedBy   User?     @relation("SupportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_requests")
}
